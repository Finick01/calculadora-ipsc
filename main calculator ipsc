<!DOCTYPE html>
<html lang="es"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Calculadora de factor IPSC</title>
<style>
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);color-scheme:light;--bg:#f4f4f1;--card:#fff;--tx:#1a1a18;--mut:#6b6b64;--bd:#d9d9d2;--ac:#c2410c;--ok:#15803d}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){color-scheme:dark;--bg:#141413;--card:#1f1f1d;--tx:#eee;--mut:#9a9a92;--bd:#34342f;--ac:#fb923c;--ok:#4ade80}}
:root[data-theme="dark"]{color-scheme:dark;--bg:#141413;--card:#1f1f1d;--tx:#eee;--mut:#9a9a92;--bd:#34342f;--ac:#fb923c;--ok:#4ade80}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--tx);font:16px/1.4 system-ui,-apple-system,Segoe UI,Roboto,sans-serif;padding:16px}
main{max-width:560px;margin:0 auto}
h1{font-size:22px;margin:0 0 4px}.sub{color:var(--mut);margin:0 0 16px;font-size:14px}
.card{background:var(--card);border:1px solid var(--bd);border-radius:14px;padding:14px;margin-bottom:12px}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
label{display:block;font-size:13px;color:var(--mut)}
input,select,button{width:100%;font:inherit;color:var(--tx);background:var(--bg);border:1px solid var(--bd);border-radius:10px;padding:10px;margin-top:4px}
button{background:var(--ac);color:#fff;border:0;font-weight:600;cursor:pointer}
button.sec{background:var(--bg);color:var(--tx);border:1px solid var(--bd)}
button:disabled{opacity:.5}
#prev{max-width:100%;border-radius:10px;margin-top:10px;display:none}
.res{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}
.opt{border:2px solid var(--bd);border-radius:12px;padding:8px 4px;text-align:center}
.opt.win{border-color:var(--ok)}
.opt h3{margin:0 0 4px;font-size:13px}
.big{font-size:22px;font-weight:700}.sm{font-size:12px;color:var(--mut)}
.rec{font-size:17px;font-weight:600;margin:0 0 6px}
.meter{position:relative;height:8px;border-radius:4px;background:linear-gradient(90deg,var(--ok),var(--bd),var(--ac));margin:14px 0 4px}
.mk{position:absolute;top:-5px;width:4px;height:18px;background:var(--tx);border-radius:2px;transform:translateX(-2px)}
.ml{display:flex;justify-content:space-between;font-size:11px;color:var(--mut);margin-bottom:10px}
.why{margin:8px 0 0;padding-left:18px;font-size:13px;color:var(--mut)}
#ia,#det{white-space:pre-wrap;font-size:14px}
.chips{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}
.chip{border:1px solid var(--bd);border-radius:999px;padding:3px 10px;font-size:13px;background:var(--bg)}
.note{font-size:12px;color:var(--mut)}
.pick{position:relative;overflow:hidden;display:block;text-align:center;background:var(--ac);color:#fff;font-weight:600;font-size:16px;border-radius:10px;padding:14px 8px;margin:0}
.pick.sec{background:var(--bg);color:var(--tx);border:1px solid var(--bd)}
.pick input{position:absolute;inset:0;width:100%;height:100%;opacity:0;margin:0;padding:0;cursor:pointer;font-size:0;border:0}
</style></head><body><main>
<h1>Calculadora de factor</h1>
<p class="sub">Tiro práctico (IPSC): tiempo estimado, hit factor y estrategia.</p>

<div class="card">
<label>Foto del campo (opcional)</label>
<div class="grid" style="margin-top:6px"><label class="pick">📷 Sacar foto<input type="file" id="foto" accept="image/*" capture="environment"></label><label class="pick sec">🖼️ Elegir de galería<input type="file" id="fotoG" accept="image/*"></label></div>
<img id="prev" alt="Foto del campo">
<button id="ana" class="sec" disabled style="margin-top:10px">Analizar foto con IA</button>
<div id="ia" class="sm" style="margin-top:8px"></div>
<div id="chips" class="chips"></div>
<div id="det" class="sm" style="margin-top:6px"></div>
<label style="display:flex;gap:8px;align-items:center;margin-top:8px"><input type="checkbox" id="usaIA" checked style="width:auto;margin:0"> Usar el tiempo de la IA (se ajusta si cambiás los datos)</label>
</div>

<div class="card"><div class="grid">
<label>Tu nivel<select id="niv"><option value="0">Principiante</option><option value="1" selected>Intermedio</option><option value="2">Avanzado</option><option value="3">Master / GM</option></select></label>
<label>Factor de potencia<select id="pf"><option value="minor">Minor</option><option value="major">Major</option></select></label>
<label>Cartones<input type="number" id="pap" value="5" min="0"></label>
<label>Platos / poppers / metal (1 tiro)<input type="number" id="ste" value="3" min="0"></label>
<label>Tiros por cartón<input type="number" id="spp" value="2" min="1" max="4"></label>
<label>Posiciones de tiro<input type="number" id="pos" value="1" min="1"></label>
<label>Metros entre posiciones<input type="number" id="met" value="5" min="0"></label>
<label>Recargas<input type="number" id="rec" value="0" min="0"></label>
<label>Distancia a blancos<select id="dis"><option value="1">Cerca (hasta 7 m)</option><option value="1.25" selected>Media (7 a 15 m)</option><option value="1.6">Lejos (más de 15 m)</option></select></label>
<label>Dificultad<select id="dif"><option value="1" selected>Blancos libres</option><option value="1.25">Cobertura parcial</option><option value="1.4">No-shoots / muy tapados</option></select></label>
</div></div>

<div class="card" id="out"></div>
<p class="note">Estimación con un modelo simple de tiempos y precisión según nivel. Sirve de guía, no reemplaza tus tiempos reales de práctica.</p>
</main>
<script>
const $=id=>document.getElementById(id);
const LV=[
 {draw:1.6,split:.35,trans:.6,speed:3.5,reload:2.6,steelMiss:.5,p:[.55,.28,.09,.08]},
 {draw:1.3,split:.25,trans:.45,speed:4.5,reload:2.1,steelMiss:.35,p:[.72,.2,.05,.03]},
 {draw:1.05,split:.2,trans:.35,speed:5.5,reload:1.7,steelMiss:.2,p:[.85,.12,.025,.005]},
 {draw:.9,split:.16,trans:.28,speed:6.5,reload:1.4,steelMiss:.1,p:[.93,.06,.01,0]}];
const GAIN=[.8,1,1.1,1.15],LOSS=[1.3,1,.75,.55];
let blob=null,sample=null,ratio=1,aiOn=false;
function adj(p,d){p=p.slice();if(d>0){d=Math.min(d,p[0]);p[0]-=d;p[1]+=d*.5;p[2]+=d*.3;p[3]+=d*.2}
 else if(d<0){const o=p[1]+p[2]+p[3],t=Math.min(-d,o);if(o>0){for(let i=1;i<4;i++)p[i]-=t*p[i]/o;p[0]+=t}}return p}
function ctx(){
 const lv=+$('niv').value,L=LV[lv],maj=$('pf').value==='major';
 const P=+$('pap').value||0,S=+$('ste').value||0,spp=+$('spp').value||2,pos=+$('pos').value||1,met=+$('met').value||0,rec=+$('rec').value||0;
 const f=(+$('dis').value)*(+$('dif').value);
 const shots=P*spp+S+S*L.steelMiss,tg=P+S;
 const tM=L.draw+shots*L.split*Math.sqrt(f)+Math.max(0,tg-1)*L.trans*f+(pos-1)*(met/L.speed+.8)+rec*L.reload;
 return{lv,L,maj,P,S,spp,f,tM,shots,t0:(aiOn&&$('usaIA').checked)?tM*ratio:tM,
  base:adj(L.p,Math.min(.35,(f-1)*.15)),cv:maj?4:3,dv:maj?2:1,max:P*spp*5+S*5,
  k:.22*(.6+(f-1)*1.2)*LOSS[lv],gain:GAIN[lv]}}
function evalS(s,c){
 const tm=s>0?1-.15*s*c.gain:1-.12*s;
 const t=Math.max(c.t0*.5,c.t0*tm+c.S*c.L.steelMiss*.8*s*(c.L.split+c.L.trans)*c.f);
 const q=adj(c.base,s>0?c.k*s:c.k*s*.6);
 const pts=Math.max(0,c.P*c.spp*(5*q[0]+c.cv*q[1]+c.dv*q[2])+c.S*5-10*c.P*c.spp*q[3]);
 return{s,t,pts,hf:pts/t,a:q[0],m:q[3]*c.P*c.spp}}
function calc(){
 const c=ctx();let best=null;
 for(let i=-10;i<=10;i++){const r=evalS(i/10,c);if(!best||r.hf>best.hf)best=r}
 const ag=evalS(.7,c),eq=evalS(0,c),pr=evalS(-.7,c),s=best.s;
 const R=s>=.6?'Andá agresivo':s>=.2?'Un poco más agresivo que equilibrado':s>-.2?'Ritmo equilibrado':s>-.6?'Un poco más preciso':'Andá preciso';
 const g=(best.hf/eq.hf-1)*100;
 const w=Math.abs(s)<.35?'eq':(s>0?'ag':'pr');
 const why=[];
 why.push(c.maj?'Con Major cada Charlie pierde solo 1 punto, así que apurarse castiga menos.':'Con Minor cada Charlie pierde 2 puntos, así que apurarse castiga más.');
 if(c.f>=1.9)why.push('Distancia y dificultad altas: los tiros apurados se van más fácil.');
 else if(c.f<=1.15)why.push('Campo abierto y cerca: se puede apretar el ritmo.');
 if(c.S>0&&c.S/(c.P+c.S)>=.4)why.push('Muchos platos: apurarlos no suma puntos y un fallo cuesta tiempo.');
 if(c.lv===0)why.push('A tu nivel, ir más tranquilo te protege de las Mike.');
 else if(c.lv===3)why.push('A tu nivel el control de tiro te deja ir al límite.');
 const card=(n,o,win)=>`<div class="opt ${win?'win':''}"><h3>${n}</h3><div class="big">${o.hf.toFixed(2)}</div><div class="sm">hit factor</div><div class="sm">${o.t.toFixed(1)} s · ${o.pts.toFixed(0)}/${c.max}</div><div class="sm">${Math.round(o.a*100)}% A · ${o.m.toFixed(1)} M</div></div>`;
 $('out').innerHTML=`<p class="rec">${R}</p>
 <div class="sm">${g<1?'La diferencia con el ritmo equilibrado es mínima.':'Ganás cerca de '+g.toFixed(0)+'% de factor frente al ritmo equilibrado.'}</div>
 <div class="meter"><div class="mk" style="left:${(s+1)*50}%"></div></div><div class="ml"><span>Preciso</span><span>Agresivo</span></div>
 <div class="res">${card('Preciso',pr,w==='pr')}${card('Equilibrado',eq,w==='eq')}${card('Agresivo',ag,w==='ag')}</div>
 <div class="sm" style="margin-top:8px">Tiros estimados: ${c.shots.toFixed(0)} · Factor equilibrado entre ${(eq.hf*.92).toFixed(2)} y ${(eq.hf*1.08).toFixed(2)}</div>
 <ul class="why">${why.slice(0,3).map(x=>'<li>'+x+'</li>').join('')}</ul>`}
document.querySelectorAll('select,input[type=number]').forEach(e=>e.addEventListener('input',calc));
$('usaIA').addEventListener('change',calc);
async function shrink(file){
 let src;
 try{src=await createImageBitmap(file)}catch(_){src=await new Promise((ok,ko)=>{const r=new FileReader();r.onload=()=>{const im=new Image();im.onload=()=>ok(im);im.onerror=ko;im.src=r.result};r.onerror=ko;r.readAsDataURL(file)})}
 const w=src.width,h=src.height,k=Math.min(1,1024/Math.max(w,h)),c=document.createElement('canvas');c.width=Math.round(w*k);c.height=Math.round(h*k);c.getContext('2d').drawImage(src,0,0,c.width,c.height);
 const b=await new Promise(ok=>c.toBlob(ok,'image/jpeg',.8));
 return{blob:b,url:c.toDataURL('image/jpeg',.6)}}
const onFoto=async e=>{const f=e.target.files[0];if(!f)return;
 aiOn=false;$('chips').innerHTML='';$('det').textContent='';calc();
 $('ia').textContent='Cargando foto...';try{const s=await shrink(f);blob=s.blob||f;$('prev').src=s.url;$('prev').style.display='block';$('ana').disabled=!sample;$('ia').textContent=sample?'Foto lista. Tocá Analizar foto con IA.':'El análisis con IA no está disponible acá. Completá los datos a mano.'}catch(_){blob=f;$('ana').disabled=!sample;$('ia').textContent='Foto cargada sin vista previa. Podés analizarla igual.'}};
$('foto').addEventListener('change',onFoto);$('fotoG').addEventListener('change',onFoto);
(async()=>{try{sample=await claude.use('sample')}catch(_){}
 if(sample&&blob)$('ana').disabled=false})();
const EM={carton:'🟫 Cartón',plato:'⚪ Plato',popper:'🔻 Popper',siluetaMetal:'🟨 Silueta metálica',noshoot:'⛔ No-shoot'};
$('ana').addEventListener('click',async()=>{
 if(!sample||!blob)return;$('ana').disabled=true;$('ia').textContent='Analizando el campo...';
 try{
  const q=`Sos un instructor de tiro práctico IPSC. Analizá esta foto de un campo (stage). Tirador: nivel ${$('niv').selectedOptions[0].text}, factor ${$('pf').value}, ${$('spp').value} tiros por cartón. Identificá CADA blanco que veas y clasificalo por MATERIAL, sin mezclar: "carton" = blanco de cartón o papel (mate, beige o claro, con o sin zonas, sostenido por palo o madera); "plato" = plato metálico chico o redondo, gris o brillante, sobre soporte de hierro; "popper" = popper metálico; "siluetaMetal" = silueta o chapa de metal pintada, a veces con salpicaduras de plomo; "noshoot" = blanco que no se debe impactar. Si dudás entre cartón y metal, fijate en el brillo, el soporte y las marcas de impacto, y anotalo en "dudas". Detectá también coberturas (paredes, barricadas, gomas, blancos tapados), zonas de falta y distancias. Calculá vos el tiempo total realista para ese nivel (draw, tiros, transiciones, movimiento, entradas y salidas de posición, recargas). Respondé SOLO un JSON con: {"blancos":[{"tipo":"carton"|"plato"|"popper"|"siluetaMetal"|"noshoot","ubicacion":"izquierda|centro|derecha, adelante|fondo","distancia_m":número,"tapado":true|false}],"tiempo_s":número,"posiciones":número,"metros_entre_posiciones":número,"distancia":"cerca"|"media"|"lejos","dificultad":"libre"|"parcial"|"noshoot","recargas":número,"coberturas":"descripción corta","dudas":"qué no pudiste distinguir, o vacío","resumen":"1 frase","consejo":"1 o 2 frases de plan de tiro en español"}`;
  let r;try{r=await sample.json(q,{images:[blob],cache:false})}catch(e){if(e&&e.code==='invalid_json'&&e.text){const m=e.text.match(/\{[\s\S]*\}/);if(!m)throw e;r=JSON.parse(m[0])}else throw e}
  if(!r||typeof r!=='object'||Array.isArray(r))throw{code:'invalid_json',message:'respuesta inesperada'};
  const bl=Array.isArray(r.blancos)?r.blancos:[];
  const n={};bl.forEach(b=>{n[b.tipo]=(n[b.tipo]||0)+1});
  if(bl.length){$('pap').value=n.carton||0;$('ste').value=(n.plato||0)+(n.popper||0)+(n.siluetaMetal||0)}
  const tapados=bl.filter(b=>b.tapado).length,ns=n.noshoot||0;
  const dd=bl.map(b=>+b.distancia_m).filter(x=>x>0);
  if(r.posiciones)$('pos').value=Math.max(1,Math.round(r.posiciones));
  if(r.metros_entre_posiciones!=null)$('met').value=Math.round(r.metros_entre_posiciones);
  let dis=({cerca:'1',media:'1.25',lejos:'1.6'})[r.distancia]||'1.25';
  if(dd.length){const av=dd.reduce((a,b)=>a+b,0)/dd.length;dis=av<=7?'1':av<=15?'1.25':'1.6'}
  $('dis').value=dis;
  let dif=({libre:'1',parcial:'1.25',noshoot:'1.4'})[r.dificultad]||'1';
  if(ns>0)dif='1.4';else if(tapados>0&&dif==='1')dif='1.25';
  $('dif').value=dif;
  if(r.recargas!=null)$('rec').value=Math.max(0,Math.round(r.recargas));
  $('chips').innerHTML=Object.keys(n).map(k=>`<span class="chip">${n[k]} ${EM[k]||k}</span>`).join('');
  const tm=ctx().tM;
  if(r.tiempo_s>0&&tm>0){ratio=Math.min(2.5,Math.max(.4,r.tiempo_s/tm));aiOn=true}else aiOn=false;
  $('ia').textContent=(aiOn?'Tiempo estimado por la IA: '+(+r.tiempo_s).toFixed(1)+' s\n':'')+(r.coberturas?'Coberturas: '+r.coberturas+'\n':'')+(r.resumen||'')+(r.consejo?'\n'+r.consejo:'');
  $('det').textContent=r.dudas?'Dudas de la IA: '+r.dudas+' Corregí los números de abajo si hace falta.':'';
  calc();
 }catch(err){const c=err&&err.code||'error';const M={not_granted:'Hace falta aceptar el permiso de IA cuando aparece el aviso. Volvé a tocar Analizar.',rate_limited:'Demasiados pedidos seguidos. Esperá un minuto y probá de nuevo.',image_rejected:'La IA no pudo leer esa imagen. Probá con otra foto.',images_unavailable:'Este visor no admite imágenes. Abrí la página desde claude.ai.',invalid_json:'La IA respondió en un formato raro. Tocá Analizar de nuevo.'};$('ia').textContent=(M[c]||'No se pudo analizar la foto.')+' ['+c+(err&&err.message?': '+String(err.message).slice(0,120):'')+']'}
 finally{$('ana').disabled=false}});
calc();
</script></body></html>
